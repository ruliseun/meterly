<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verification Success - Meterly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap" rel="stylesheet">
</head>

<body style="margin: 0; padding: 0; background-color: #ffffff; font-family: 'Lato', Arial, sans-serif;">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #ffffff;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table width="600" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px;">
                    <tr>
                        <td style="padding: 40px; text-align: center;">
                            <!-- Logo/Header -->
                            <h1 style="margin: 0 0 40px; font-size: 28px; color: #111827; font-weight: 700;">Meterly
                            </h1>

                            <!-- Success Icon -->
                            <div style="margin-bottom: 24px;">
                                <svg width="60" height="70" viewBox="0 0 60 70" fill="none"
                                    xmlns="http://www.w3.org/2000/svg" style="display: inline-block;">
                                    <circle cx="33" cy="37" r="25" fill="#15803D" />
                                    <path
                                        d="M46.3332 35.7732V36.9999C46.3315 39.8751 45.4005 42.6728 43.679 44.9757C41.9574 47.2785 39.5376 48.9632 36.7803 49.7784C34.0231 50.5937 31.0762 50.4958 28.3791 49.4993C25.6821 48.5029 23.3794 46.6614 21.8145 44.2493C20.2495 41.8373 19.5062 38.984 19.6954 36.115C19.8846 33.246 20.9961 30.515 22.8642 28.3293C24.7323 26.1437 27.2569 24.6204 30.0614 23.9868C32.866 23.3531 35.8002 23.643 38.4265 24.8132M46.3332 26.3332L32.9998 39.6799L28.9998 35.6799"
                                        stroke="white" stroke-width="3" stroke-linecap="round"
                                        stroke-linejoin="round" />
                                    <circle cx="52.5" cy="7.5" r="7.5" fill="#BBF7D0" />
                                    <circle cx="7.5" cy="62.5" r="7.5" fill="#BBF7D0" />
                                </svg>
                            </div>

                            <!-- Main Content -->
                            <h2 style="margin: 0 0 16px; font-size: 24px; color: #111827; font-weight: 700;">Your Email
                                has been verified!</h2>
                            <p style="margin: 0 0 32px; font-size: 16px; line-height: 24px; color: #6B7280;">
                                Your email has been verified, you can now proceed continue with your profile setup
                            </p>

                            <!-- CTA Button -->
                            <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                <tr>
                                    <td align="center">
                                        <a href="<%= loginUrl %>"
                                            style="display: inline-block; padding: 12px 24px; background-color: #2563EB; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 500; font-size: 16px; min-width: 200px;">Proceed
                                            to Log In</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>