{
  "name": "meterly-backend",
  "version": "1.0.0",
  "description": "API for Meterly backend",
  "main": "app.js",
  "scripts": {
    "dev:run": "ts-node-dev --respawn ./dist/app.js",
    "start": "node ./dist/app.js",
    "push:compile": "tsc -w",
    "compile": "rimraf ./dist/migration/* && tsc -p . -w",
    "build": "babel src --out-dir dist --extensions \".ts,.tsx\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prettier": "prettier --write src/**/*.ts",
    "prettier:check": "prettier --check src/**/*.ts",
    "format": "npm run prettier && npm run lint:fix",
    "check": "npm run prettier:check && npm run lint",
    "dev": "concurrently \"npx tsc -w\" \"nodemon src/app.ts\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d ./src/data-source.ts ./src/migration/db-migration",
    "migration:run": "npm run typeorm -- migration:run -d ./src/data-source.ts",
    "migration-prod:generate": "npm run typeorm -- migration:generate -d ./src/data-source.ts ./dist/src/migration/db-migration",
    "migration-prod:run": "npm run typeorm -- migration:run -d ./dist/data-source.js",
    "migration:revert": "npm run typeorm -- migration:revert -d ./dist/src/data-source.js",
    "prepare": "husky",
    "scaffold": "node scripts/scaffold-feature.js"
  },
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "src/**/*.ts": [
      "npm run lint"
    ]
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@sentry/cli": "^2.46.0",
    "@sentry/node": "^9.23.0",
    "@types/axios": "^0.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull-board": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/ejs": "^3.1.5",
    "@types/he": "^1.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/json2csv": "^5.0.7",
    "@types/maildev": "^0.0.7",
    "@types/mailgun-js": "^0.22.18",
    "@types/marked": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "@types/otp-generator": "^4.0.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/streamifier": "^0.1.2",
    "@types/stripe": "^8.0.416",
    "@types/twilio": "^3.19.2",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "bull-board": "^1.7.2",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
